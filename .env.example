# Netlify build-time public Supabase configuration.
# The anon/publishable key is designed to be exposed to browser clients.
# NEVER put SUPABASE_SERVICE_ROLE_KEY or RESEND_API_KEY here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
APP_URL=https://your-app.netlify.app
